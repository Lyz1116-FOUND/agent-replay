{
  "name": "agent-replay",
  "version": "0.3.0",
  "description": "A visual debugger for coding agents that replays native agent events against verified workspace facts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "agent-replay": "dist-cli/agent-replay.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/agent-replay.mjs && npm run build:validate && chmod +x dist-cli/agent-replay.mjs",
    "cli": "node dist-cli/agent-replay.mjs",
    "build:validate": "esbuild cli/validation/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/validate.mjs",
    "validate": "node dist-cli/validate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
